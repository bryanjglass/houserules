generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// role: "PARENT" | "CHILD"
// householdCode: random per-parent code that gates the public child lookup (parents only)
// timezone: IANA name (e.g. "America/Chicago") for the household; meaningful on the
//   parent row, inherited by children via parentId. Source of truth for all
//   calendar-day decisions (recurring generation + future-completion guard).
// pinHash: bcrypt hash of a child's 4-digit PIN (children only)
// pinFailedAttempts / pinLockedUntil: per-child PIN lockout state
// googleId: Google account subject ("sub") for parents who sign in with Google.
//   Null for password-only parents and all children. Set on first Google sign-in
//   or when a verified Google email is auto-linked to an existing parent.
model User {
  id                String    @id @default(cuid())
  name              String
  email             String?   @unique
  googleId          String?   @unique
  householdCode     String?   @unique
  timezone          String    @default("UTC")
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  passwordHash      String?
  role              String    @default("CHILD")
  parentId          String?
  parent            User?     @relation("Family", fields: [parentId], references: [id])
  children          User[]    @relation("Family")
  createdAt         DateTime  @default(now())

  assignedChores  Chore[]           @relation("AssignedChores")
  householdChores Chore[]           @relation("HouseholdChores")
  completions     ChoreCompletion[] @relation("ChildCompletions")
  transactions    Transaction[]
  trustedDevices  TrustedDevice[]   @relation("HouseholdDevices")
  rememberedOn    TrustedDevice[]   @relation("RememberedChildren")
  savingsGoals    SavingsGoal[]     @relation("ChildGoals")
  createdGoals    SavingsGoal[]     @relation("CreatedGoals")
  pushTokens      PushToken[]

  @@index([parentId])
}

// A physical device a household has chosen to trust for passwordless child re-login.
// tokenHash: bcrypt hash of the opaque device token stored in the client cookie.
// children: the children who have opted to be remembered (one-tap login) on this device.
model TrustedDevice {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  parentId   String
  parent     User     @relation("HouseholdDevices", fields: [parentId], references: [id])
  label      String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  children   User[]   @relation("RememberedChildren")

  @@index([parentId])
}

// A chore DEFINITION — what a parent creates and edits. Carries no lifecycle
// status; work lives in ChoreCompletion rows, and future occurrences of a
// recurring chore are projected at read time from this definition (never
// materialized ahead of a user action — see src/lib/projection.ts).
//
// kind: "ASSIGNED" (one child) | "OPEN" (household pool, claimed per occurrence)
//       | "PER_UNIT" (household pool, logged per item, never recurring)
// recurrence: null (one-off) | "DAILY" | "WEEKLY" | "MONTHLY"
// weeklyDays: comma-separated day numbers 0-6 (0=Sun..6=Sat) for WEEKLY; null/empty = every 7 days
// startDay: household-local calendar day "YYYY-MM-DD" — a one-off's due day
//   (optional) or a recurring chore's schedule anchor (always set, snapped to the
//   first scheduled occurrence).
// missedPolicy ("CURRENT_ONLY" | "BACKFILL_14D"): how missed occurrences of a
//   recurring ASSIGNED chore surface — only the earliest unresolved one, or every
//   unresolved scheduled day in the last 14 days. Ignored for OPEN/PER_UNIT.
// rewardCents: flat reward (ASSIGNED/OPEN); unitRewardCents: per-item (PER_UNIT).
// archivedAt: archived chores stop projecting and accepting work; history kept.
model Chore {
  id              String    @id @default(cuid())
  householdId     String // the parent who owns this chore (and the household scope)
  household       User      @relation("HouseholdChores", fields: [householdId], references: [id])
  kind            String
  title           String
  description     String?
  rewardCents     Int?
  unitRewardCents Int?
  assigneeId      String?
  assignee        User?     @relation("AssignedChores", fields: [assigneeId], references: [id])
  recurrence      String?
  weeklyDays      String?
  startDay        String?
  missedPolicy    String    @default("CURRENT_ONLY")
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())

  completions ChoreCompletion[]

  @@index([householdId])
  @@index([assigneeId])
}

// A child's work record on a chore. Always belongs to a child.
// status: "PENDING" (claimed/sent back, not yet done) | "COMPLETED" (awaiting
//   review) | "APPROVED" (credited). Rejection flips back to PENDING, except
//   per-unit logs which are deleted (the child just re-logs).
// occurrenceKey: the household-local day "YYYY-MM-DD" this row resolves, or
//   "once" for a one-off. The (choreId, occurrenceKey) unique constraint IS the
//   claim/complete race guard — exactly one row can win an occurrence. Per-unit
//   logs use null (SQLite unique indexes treat NULLs as distinct), so logs are
//   unlimited and never conflict.
// rewardCents: snapshot at creation (PER_UNIT: unit reward × quantity, recomputed
//   if the parent adjusts the count at approval). Approval pays this snapshot, so
//   editing the chore definition never changes in-flight or approved work.
model ChoreCompletion {
  id            String    @id @default(cuid())
  choreId       String
  chore         Chore     @relation(fields: [choreId], references: [id])
  childId       String
  child         User      @relation("ChildCompletions", fields: [childId], references: [id])
  occurrenceKey String?
  status        String    @default("PENDING")
  quantity      Int?
  rewardCents   Int?
  completedAt   DateTime?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  transaction Transaction?

  @@unique([choreId, occurrenceKey])
  @@index([childId])
  @@index([choreId])
}

// type: "EARNED" | "ADJUSTMENT" | "REDEEMED"
// REDEEMED: a negative entry from cashing in a savings goal (linked via goalId).
model Transaction {
  id           String           @id @default(cuid())
  userId       String
  user         User             @relation(fields: [userId], references: [id])
  completionId String?          @unique
  completion   ChoreCompletion? @relation(fields: [completionId], references: [id])
  goalId       String?          @unique
  goal      SavingsGoal? @relation(fields: [goalId], references: [id])
  amount    Int // integer cents; negative for deductions
  type      String
  note      String?
  createdAt DateTime     @default(now())

  @@index([userId])
}

// status: "ACTIVE" | "REDEEM_REQUESTED" | "REDEEMED"
// A parent-set savings target for a child. Progress is DERIVED (the child's
// balance vs targetAmount) and never stored; a goal touches money only once, at
// cash-in approval, which writes a single negative REDEEMED transaction.
// targetAmount is integer cents (like Task.dollarAmount).
// At most one non-redeemed goal per child is enforced in the API, not the
// schema, so multiple goals (sharing the one balance pool) can be enabled later.
model SavingsGoal {
  id           String       @id @default(cuid())
  childId      String
  child        User         @relation("ChildGoals", fields: [childId], references: [id])
  createdById  String
  createdBy    User         @relation("CreatedGoals", fields: [createdById], references: [id])
  title        String
  targetAmount Int
  status       String       @default("ACTIVE")
  createdAt    DateTime     @default(now())
  redeemedAt   DateTime?
  transaction  Transaction?

  @@index([childId])
  @@index([createdById])
}

// platform: "android" (room for "ios"/"web" later)
// token: the FCM registration token issued to the device by Google Play Services.
// One user can have multiple tokens (phone + tablet). Upserted on token value;
// the userId is reassigned if a shared device re-registers after a different login.
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}
