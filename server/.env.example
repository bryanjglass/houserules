DATABASE_URL="file:/data/prod.db"
JWT_SECRET="change-me-use-a-long-random-string-32-chars-minimum"
PORT=3001
NODE_ENV=production
CLIENT_URL=https://your-app.railway.app
# Firebase service-account key JSON (stringified). Omit to disable push notifications.
FIREBASE_SERVICE_ACCOUNT=
# Google OAuth client ID (web). The server verifies Google ID tokens against this
# audience; the client uses it to render the "Sign in with Google" button.
# Omit to disable Google login. No client secret is needed (token model).
GOOGLE_CLIENT_ID=
